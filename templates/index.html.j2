<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ site.motto }}">
  <link rel="alternate" type="application/rss+xml" title="ThreatWire RSS" href="{{ base }}feed.xml">
  <!-- Fallback auto-refresh; the live poller below reloads sooner when a new edition ships. -->
  <meta http-equiv="refresh" content="900">
  <title>{{ site.name }} — {{ site.tagline }}</title>
  <link rel="stylesheet" href="{{ base }}style.css">
</head>
<body>
<div id="newedition" class="new-edition">New edition just published — refreshing…</div>
<div class="paper">

  <header class="masthead">
    <div class="dateline">
      <span>{{ edition }}</span>
      <span class="dot">•</span>
      <span>{{ built_at }}</span>
      <span class="dot">•</span>
      <span class="live"><span class="live-dot"></span>LIVE · updated <span id="live-ago">just now</span></span>
    </div>
    <h1 class="nameplate">{{ site.name }}</h1>
    <p class="tagline">{{ site.tagline }}</p>
    <div class="posture {{ posture_class }}">
      Global Threat Posture: <strong>{{ posture }}</strong>
      <span class="posture-meta">{{ sev_counts[3] }} critical · {{ sev_counts[2] }} high · {{ total }} stories on the wire</span>
    </div>
  </header>

  {% include "_nav.html.j2" %}
  <div class="rule-double"></div>

  {% if lead %}
  <div class="frontpage">
    <main class="lead-col">
      <article class="lead">
        <span class="kicker {{ 'sev-'~lead.severity }}">{{ lead.kicker }}{% if lead.severity >= 2 %} · {{ lead.sev_label }}{% endif %}</span>
        <h2 class="lead-hl"><a href="{{ base }}{{ lead.href }}">{{ lead.title }}</a></h2>
        <p class="byline">{{ lead.source }}<span class="dot">•</span>{{ lead.ago }}{% if lead.coverage_label %}<span class="cov">{{ lead.coverage_label }}</span>{% endif %}</p>
        {% if lead.summary %}<p class="lead-body">{{ lead.summary }}</p>{% endif %}
      </article>

      <div class="secondary">
        {% for s in secondary %}
        <article class="story">
          <span class="kicker {{ 'sev-'~s.severity }}">{{ s.kicker }}</span>
          <h3><a href="{{ base }}{{ s.href }}">{{ s.title }}</a></h3>
          <p class="byline">{{ s.source }}<span class="dot">•</span>{{ s.ago }}{% if s.coverage_label %}<span class="cov">{{ s.coverage_label }}</span>{% endif %}</p>
          {% if s.summary %}<p class="story-body">{{ s.summary }}</p>{% endif %}
        </article>
        {% endfor %}
      </div>
    </main>

    <aside class="rail">
      {% if pov %}
      <section class="rail-box pov-box">
        <h4 class="rail-title">PoV of the Day</h4>
        <a href="{{ base }}pov.html" class="pov-title">{{ pov.title }}</a>
        <p class="pov-excerpt">{{ pov.paragraphs[0] }}</p>
        <a href="{{ base }}pov.html" class="pov-more">Read the full view →</a>
      </section>
      {% endif %}

      {% if product %}
      <section class="rail-box product-box">
        <h4 class="rail-title">Product of the Day</h4>
        <a href="{{ base }}feature.html" class="pov-title">{{ product.name }}</a>
        <p class="product-cat">{{ product.vendor }} · {{ product.category }}</p>
        <p class="pov-excerpt">{{ product.one_liner }}</p>
        <a href="{{ base }}feature.html" class="pov-more">Read the profile →</a>
      </section>
      {% endif %}

      <section class="rail-box threat-level">
        <h4 class="rail-title">Threat Level</h4>
        <div class="level-row"><span class="tag sev-3">Critical</span><span class="bar"><i style="width:{{ (sev_counts[3]/total*100) if total else 0 }}%"></i></span><b>{{ sev_counts[3] }}</b></div>
        <div class="level-row"><span class="tag sev-2">High</span><span class="bar"><i style="width:{{ (sev_counts[2]/total*100) if total else 0 }}%"></i></span><b>{{ sev_counts[2] }}</b></div>
        <div class="level-row"><span class="tag sev-1">Notable</span><span class="bar"><i style="width:{{ (sev_counts[1]/total*100) if total else 0 }}%"></i></span><b>{{ sev_counts[1] }}</b></div>
      </section>

      {% if critical %}
      <section class="rail-box">
        <h4 class="rail-title">Critical Now</h4>
        <ul class="rail-list">
          {% for c in critical %}
          <li><a href="{{ base }}{{ c.href }}">{{ c.title }}</a><span class="rail-meta">{{ c.source }} · {{ c.ago }}</span></li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      <section class="rail-box">
        <h4 class="rail-title">Most Active Sources</h4>
        <ul class="rail-list compact">
          {% for name, count in top_sources %}
          <li><span>{{ name }}</span><b>{{ count }}</b></li>
          {% endfor %}
        </ul>
      </section>
    </aside>
  </div>

  <div class="rule-single"></div>

  <section class="wire">
    <div class="wire-head">
      <h4 class="section-head">The Wire — Latest</h4>
      <div class="filters" id="filters">
        <button class="filter active" data-filter="all">All</button>
        <button class="filter" data-filter="sev:3">Critical</button>
        <button class="filter" data-filter="sev:2">High</button>
        {% for t in nav %}
        <button class="filter" data-filter="topic:{{ t.label|lower }}">{{ t.label }}</button>
        {% endfor %}
      </div>
    </div>
    <p class="filter-count" id="filter-count"></p>
    <div class="wire-grid" id="wire-grid">
      {% for it in features %}
      <article class="wire-item" data-sev="{{ it.severity }}" data-topics="{{ it.topics|join(',')|lower }}">
        <span class="sev-dot sev-{{ it.severity }}" title="{{ it.sev_label }}"></span>
        <div>
          <h5><a href="{{ base }}{{ it.href }}">{{ it.title }}</a></h5>
          <p class="wire-meta">{{ it.source }}<span class="dot">•</span>{{ it.ago }}{% if it.coverage_label %}<span class="dot">•</span>{{ it.coverage_label }}{% endif %}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% else %}
  <p class="empty">No stories on the wire yet — the fetch loop hasn't produced results.</p>
  {% endif %}

  <footer class="colophon">
    <p class="motto">{{ site.motto }}</p>
    <p class="sources">Sourced from {{ top_sources|length }}+ threat-intelligence wires. Headlines open a ThreatWire brief that links to the original reporting; copyright remains with each publisher.</p>
    <p class="built">Edition built {{ built_at }} · this page auto-updates when a new edition publishes.</p>
  </footer>

</div>

<script>
(function () {
  var BUILT = {{ built_epoch }};
  var statusUrl = "{{ base }}status.json";

  function tick() {
    var el = document.getElementById('live-ago');
    if (!el) return;
    var s = Math.max(0, Math.floor(Date.now() / 1000) - BUILT);
    var m = Math.floor(s / 60);
    el.textContent = m < 1 ? 'just now' : (m < 60 ? m + 'm ago' : Math.floor(m / 60) + 'h ago');
  }
  tick();
  setInterval(tick, 15000);

  async function poll() {
    try {
      var r = await fetch(statusUrl + '?t=' + Date.now(), { cache: 'no-store' });
      if (!r.ok) return;
      var d = await r.json();
      if (d.built_epoch && d.built_epoch > BUILT) {
        var b = document.getElementById('newedition');
        if (b) b.classList.add('show');
        setTimeout(function () { location.reload(); }, 2500);
      }
    } catch (e) { /* offline or transient — try again next tick */ }
  }
  setInterval(poll, 60000);

  // Dynamic wire filtering — client-side, no reload.
  var items = Array.prototype.slice.call(document.querySelectorAll('#wire-grid .wire-item'));
  var buttons = Array.prototype.slice.call(document.querySelectorAll('#filters .filter'));
  var countEl = document.getElementById('filter-count');
  function applyFilter(f) {
    var shown = 0;
    items.forEach(function (el) {
      var ok = f === 'all';
      if (!ok && f.indexOf('sev:') === 0) ok = el.getAttribute('data-sev') === f.slice(4);
      if (!ok && f.indexOf('topic:') === 0) ok = (',' + el.getAttribute('data-topics') + ',').indexOf(',' + f.slice(6) + ',') !== -1;
      el.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    countEl.textContent = f === 'all' ? '' : (shown + ' matching ' + (shown === 1 ? 'story' : 'stories'));
  }
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      buttons.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      applyFilter(btn.getAttribute('data-filter'));
    });
  });
})();
</script>
</body>
</html>
